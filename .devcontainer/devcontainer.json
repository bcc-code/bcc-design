// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
  "name": "@bcc-code/component-library-vue",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/typescript-node:4-24-trixie",
  "features": {
    "ghcr.io/devcontainers/features/node:2.0.0": {
      "pnpmVersion": "11.23.0"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },

  "postCreateCommand": {
    "pnpm": "cd component-library ; pnpm completion bash >> ~/.bashrc ; pnpm install",
    "git-credentials": "git config --global credential.https://github.com.helper '${containerWorkspaceFolder}/.devcontainer/git-credential-env.sh'",
    "shell-env": "grep -qs load-env.sh ~/.bashrc || echo \". '${containerWorkspaceFolder}/.devcontainer/load-env.sh' '${containerWorkspaceFolder}/.devcontainer/.env'\" >> ~/.bashrc"
  },

  // Token for git over HTTPS. Empty when unset on the host; .devcontainer/.env takes precedence.
  "containerEnv": {
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "dbaeumer.vscode-eslint",
        "stylelint.vscode-stylelint",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "vitest.explorer",
        "unifiedjs.vscode-mdx",
        "github.vscode-github-actions"
      ]
    }
  }
}
